{
  "name": "useless-dave",
  "version": "1.0.0",
  "private": true,
  "description": "Small business ERP for expense tracking",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "client": "npm run dev -w client",
    "server": "npm run dev -w server",
    "emulators": "firebase emulators:start",
    "build": "npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "deploy": "npm run build && firebase deploy",
    "prepare": "husky"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,json}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0"
  }
}
