{
  "name": "useless-dave-server",
  "version": "1.0.0",
  "description": "Firebase Functions for Useless Dave ERP",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "dev": "npm run build && node dist/dev-server.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "typescript": "^5.8.0"
  },
  "private": true
}
