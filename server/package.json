{
  "name": "useless-dave-server",
  "version": "1.0.0",
  "description": "Firebase Functions for Useless Dave ERP",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^7.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "typescript": "^5.8.0"
  },
  "private": true
}
