{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noForEach": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "includes": [
      "client/src/**/*.ts",
      "client/src/**/*.tsx",
      "client/*.ts",
      "client/*.js",
      "server/src/**/*.ts",
      "server/*.ts",
      "server/*.js",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.firebase"
    ]
  }
}
